{
  "id": "sf.typography",
  "name": "Typography",
  "version": "1.0.0",
  "description": "Create actual editable Text layers. Keep exact content including Chinese; use real family names and shared font-size ranges. Center placement uses composition pixels. Verify text geometry and native rendering, never assume a particular external font exists.",
  "supportedTasks": ["typography"],
  "requiredCapabilities": [
    "createText",
    "setFont",
    "setFontSize",
    "setTextContent"
  ],
  "optionalCapabilities": [
    "setPosition",
    "setFill",
    "setTracking",
    "setLeading"
  ],
  "supportedObjectTypes": ["Layer", "Property", "GraphNode"],
  "inputs": {
    "goal": "explicit native editing task",
    "scope": "existing user authorization"
  },
  "outputs": {
    "result": "verified editable draft"
  },
  "prerequisites": ["active-composition", "valid-object-references"],
  "permissionRequirements": ["existing-user-scope"],
  "compatibility": {
    "runtime": 1
  },
  "recoveryPolicy": "shared-bounded-controller",
  "keywords": [
    "标题",
    "文字",
    "字体",
    "文本",
    "text",
    "typography",
    "title",
    "Cubic"
  ]
}
