{
  "id": "sf.shape-creation",
  "name": "Shape Creation",
  "version": "1.0.0",
  "description": "Create editable native geometry using actual composition bounds. Bind each result independently; preserve names, shape alpha and geometry. Never create graph generators as substitute shapes.",
  "supportedTasks": ["shape-creation"],
  "requiredCapabilities": [
    "createShape",
    "createRectangle",
    "createEllipse",
    "createPolygon",
    "createStar"
  ],
  "optionalCapabilities": ["setPosition", "placeAtCompositionCenter"],
  "supportedObjectTypes": ["Layer", "Property", "GraphNode"],
  "inputs": {
    "goal": "explicit native editing task",
    "scope": "existing user authorization"
  },
  "outputs": {
    "result": "verified editable draft"
  },
  "prerequisites": ["active-composition", "valid-object-references"],
  "permissionRequirements": ["existing-user-scope"],
  "compatibility": {
    "runtime": 1
  },
  "recoveryPolicy": "shared-bounded-controller",
  "keywords": ["shape", "矩形", "椭圆", "图形", "rectangle", "shape"]
}
