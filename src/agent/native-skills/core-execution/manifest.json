{
  "id": "sf.core-execution",
  "name": "Swayframe Core Execution",
  "version": "1.0.0",
  "description": "Use the shared deterministic execution, object binding, dependency, recovery and verification pipeline.",
  "supportedTasks": ["native-edit"],
  "requiredCapabilities": [
    "createRectangle",
    "setFill",
    "setPosition",
    "addKeyframe"
  ],
  "optionalCapabilities": ["renderFrame"],
  "supportedObjectTypes": ["Layer", "Property", "GraphNode"],
  "inputs": {
    "goal": "nonempty user request",
    "scope": "existing execution scope"
  },
  "outputs": { "result": "validated editable draft and one explicit commit" },
  "prerequisites": ["active-composition", "valid-object-references"],
  "permissionRequirements": ["existing-user-scope"],
  "compatibility": { "runtime": 1 },
  "recoveryPolicy": "shared-bounded-controller",
  "keywords": []
}
