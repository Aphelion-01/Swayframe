{
  "actions": ["createRectangle", "setFill", "setPosition", "addKeyframe"],
  "constraints": [
    "registered-tools",
    "actual-object-binding",
    "dependency-validation",
    "shared-command-transaction",
    "bounded-recovery",
    "scene-verification",
    "render-verification"
  ],
  "validationRules": ["valid-plan", "native-scene", "native-render"],
  "sequence": [
    "discover",
    "plan",
    "validate",
    "resolve",
    "compile",
    "execute-draft",
    "verify",
    "commit"
  ]
}
