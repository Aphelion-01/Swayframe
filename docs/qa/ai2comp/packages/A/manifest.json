{
  "format": "swayframe.layerpack",
  "version": 1,
  "colorSpace": "srgb",
  "alphaMode": "straight",
  "order": "bottom-to-top",
  "canvas": {
    "width": 64,
    "height": 48
  },
  "layers": [
    {
      "id": "background",
      "name": "Background",
      "type": "raster",
      "asset": "layers/background.png",
      "bounds": {
        "x": 0,
        "y": 0,
        "width": 64,
        "height": 48
      },
      "opacity": 1
    },
    {
      "id": "subject",
      "name": "Subject",
      "type": "raster",
      "asset": "layers/subject.png",
      "bounds": {
        "x": 0,
        "y": 0,
        "width": 64,
        "height": 48
      },
      "opacity": 1
    },
    {
      "id": "foreground",
      "name": "Foreground",
      "type": "raster",
      "asset": "layers/foreground.png",
      "bounds": {
        "x": 0,
        "y": 0,
        "width": 64,
        "height": 48
      },
      "opacity": 1
    }
  ]
}
