{
  "name": "motion-system",
  "private": true,
  "version": "0.9.12",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check src tests scripts apps *.json *.ts *.html *.cjs build/*.json docs/ARCHITECTURE.md",
    "format": "prettier --write src tests scripts apps *.json *.ts *.html *.cjs build/*.json docs/ARCHITECTURE.md",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:dev": "node scripts/desktop/dev.mjs",
    "desktop:build": "npm run build && node scripts/desktop/build.mjs",
    "package:mac": "npm run desktop:build && electron-builder --config electron-builder.config.cjs --mac --arm64",
    "package:win": "npm run desktop:build && electron-builder --config electron-builder.config.cjs --win --x64",
    "benchmark": "node scripts/performance.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "main": "desktop-dist/main.cjs",
  "description": "Swayframe desktop motion design editor",
  "author": "Swayframe"
}
